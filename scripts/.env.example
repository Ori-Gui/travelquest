# =====================================================================
# docker-compose 용 환경변수 예시
# 사용법: 이 파일을 scripts/.env 로 복사한 뒤 값을 채웁니다(선택).
#   cp .env.example .env      (scripts 디렉터리에서)
# 값을 비우면 docker-compose.yml 의 기본값을 사용합니다.
# =====================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- MongoDB ---
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# --- mongo-express 웹 로그인 ---
MONGO_EXPRESS_USER=
MONGO_EXPRESS_PASSWORD=
