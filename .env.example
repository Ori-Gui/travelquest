# =====================================================================
# TravelQuest 백엔드 환경변수 예시
# ---------------------------------------------------------------------
# 이 파일은 키 목록만 담습니다. 실제 값은 절대 커밋하지 마세요.
# 사용법: 키를 참고해 실행 환경에 값을 주입합니다.
#   - IntelliJ: Run/Debug Configurations > Environment variables
#   - 셸:  export JWT_SECRET=...  (혹은 .env 를 직접 export)
#   - 배포: 사용하는 플랫폼의 환경변수 설정
# =====================================================================

# --- OpenAI (퀘스트 자동 생성, spring.ai.openai.api-key) ---
OPEN_API_KEY=

# --- OAuth2: Kakao (client-id 만 사용, 시크릿 없음) ---
KAKAO_CLIENT_ID=

# --- OAuth2: Naver ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- JWT 서명 키 ---
# HS256 기준 32바이트 이상. Base64 문자열 권장. (openssl rand -base64 32)
JWT_SECRET=

# --- MySQL ---
# DB_URL 을 비우면 jdbc:mysql://192.168.205.64:3306/ssafytrip?serverTimezone=UTC 사용
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- Redis ---
# 비우면 192.168.205.64:6379 사용
REDIS_HOST=
REDIS_PORT=

# --- MongoDB ---
# mongodb://<user>:<password>@<host>:27017/travelquest?authSource=admin
MONGODB_URI=

# --- 업로드 경로 / 프론트 콜백 ---
# UPLOAD_DIR 을 비우면 uploads/images, FRONT_REDIRECT_BASE 를 비우면
# http://192.168.205.51:5173/oauth/callback 사용
UPLOAD_DIR=
FRONT_REDIRECT_BASE=
