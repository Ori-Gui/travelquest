<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//MyBatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.travelquest.domain.user.repository.UserRepository">

    <resultMap id="userResultMap" type="com.ssafy.travelquest.domain.user.entity.User">
        <id property="id" column="id"/>
        <result property="userName" column="user_name"/>
        <result property="email" column="email"/>
        <result property="mbti" column="mbti" javaType="com.ssafy.travelquest.domain.user.entity.MBTI"/>
        <result property="jobClassCode" column="job_class_code" javaType="com.ssafy.travelquest.domain.user.entity.JobCode"/>
        <result property="birthday" column="birthday"/>
        <result property="createdAt" column="created_at"/>
        <result property="role" column="role" javaType="com.ssafy.travelquest.domain.user.entity.UserRole"/>
        <result property="registStatus" column="regist_status" javaType="com.ssafy.travelquest.domain.user.entity.RegistStatus"/>
    </resultMap>

    <select id="findAll" resultMap="userResultMap">
        SELECT * FROM user
    </select>

    <select id="findById" resultMap="userResultMap" parameterType="long">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.ssafy.travelquest.domain.user.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (user_name, email, mbti, job_class_code, birthday, created_at, role, regist_status)
        VALUES (#{userName}, #{email}, #{mbti}, #{jobClassCode}, #{birthday}, #{createdAt}, #{role}, #{registStatus})
    </insert>

    <update id="update" parameterType="com.ssafy.travelquest.domain.user.entity.User">
        UPDATE user
        SET user_name = #{userName},
            email = #{email},
            mbti = #{mbti},
            job_class_code = #{jobClassCode},
            birthday = #{birthday},
            created_at = #{createdAt},
            role = #{role},
            regist_status = #{registStatus}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <select id="findByUserNameAndEmail" resultMap="userResultMap" parameterType="map">
        SELECT * FROM user
        WHERE user_name = #{userName}
          AND email = #{email}
    </select>

    <!-- 여러 userId 목록으로 한 번에 조회 -->
    <select id="findAllByIds"
            resultMap="userResultMap"
            parameterType="java.util.List">
        SELECT *
        FROM user
        WHERE id IN
        <foreach item="id"
                 collection="list"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
    </select>
</mapper>
