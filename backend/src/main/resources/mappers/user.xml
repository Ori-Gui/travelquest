<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//MyBatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.travelquest.domain.user.repository.UserRepository">

    <resultMap id="userResultMap" type="com.ssafy.travelquest.domain.user.entity.User">
        <id property="id" column="id"/>
        <result property="userName" column="user_name"/>
        <result property="email" column="email"/>
        <result property="mbti" column="mbti" javaType="com.ssafy.travelquest.domain.user.entity.MBTI"/>
        <result property="jobClassCode" column="job_class_code" javaType="com.ssafy.travelquest.domain.user.entity.JobCode"/>
        <result property="joinDate" column="join_date"/>
        <result property="role" column="role" javaType="com.ssafy.travelquest.domain.user.entity.UserRole"/>
    </resultMap>

    <select id="findAll" resultMap="userResultMap">
        SELECT * FROM users
    </select>

    <select id="findById" resultMap="userResultMap" parameterType="long">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.ssafy.travelquest.domain.user.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (user_name, email, mbti, job_class_code, join_date, role)
        VALUES (#{userName}, #{email}, #{mbti}, #{jobClassCode}, #{joinDate}, #{role})
    </insert>

    <update id="update" parameterType="com.ssafy.travelquest.domain.user.entity.User">
        UPDATE users
        SET user_name = #{userName},
            email = #{email},
            mbti = #{mbti},
            job_class_code = #{jobClassCode},
            role = #{role}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM users WHERE id = #{id}
    </delete>

    <select id="findByUserNameAndEmail" resultMap="userResultMap" parameterType="map">
        SELECT * FROM users
        WHERE user_name = #{userName}
          AND email = #{email}
    </select>

</mapper>
