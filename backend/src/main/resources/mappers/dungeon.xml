<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
         "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.travelquest.domain.dungeon.repository.DungeonRepository">

  <!-- 특정 던전에 연결된 여행지 리스트 조회 -->
  <select id="getAttractionsByDungeonId"
          parameterType="int"
          resultType="Attraction">
    SELECT a.*
      FROM attractions a
      JOIN dungeon_attraction da ON a.no = da.attraction_id
     WHERE da.dungeon_id = #{dungeonId}
  </select>

  <!-- 여행지 ID 리스트 중 하나라도 포함하는 던전 리스트 조회 -->
  <select id="findDungeonsByAttractionIds"
          parameterType="java.util.List"
          resultType="Dungeon">
    SELECT d.*
      FROM dungeon d
      JOIN dungeon_attraction da ON d.id = da.dungeon_id
     WHERE da.attraction_id IN
     <foreach item="id" collection="ids" open="(" separator="," close=")">
       #{id}
     </foreach>
  </select>

</mapper>