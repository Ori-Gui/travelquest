<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.travelquest.domain.chat.chatroom.repository.ChatRoomRepository">

    <resultMap id="ChatRoomResultMap" type="com.ssafy.travelquest.domain.chat.chatroom.entity.ChatRoom">
        <id property="id" column="id" />
        <result property="partyId" column="party_id" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <insert id="insert" parameterType="com.ssafy.travelquest.domain.chat.chatroom.entity.ChatRoom" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_room (party_id, created_at)
        VALUES (#{partyId}, #{createdAt})
    </insert>

    <delete id="deleteByPartyId" parameterType="long">
        DELETE FROM chat_room
        WHERE party_id = #{partyId}
    </delete>

    <delete id="deleteById" parameterType="long">
        DELETE FROM chat_room
        WHERE id = #{id}
    </delete>

    <select id="findByPartyId" parameterType="long" resultMap="ChatRoomResultMap">
        SELECT id, party_id, created_at
        FROM chat_room
        WHERE party_id = #{partyId}
    </select>

    <select id="findById" parameterType="long" resultMap="ChatRoomResultMap">
        SELECT id, party_id, created_at
        FROM chat_room
        WHERE id = #{id}
    </select>

</mapper>