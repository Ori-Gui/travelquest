<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
         "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.travelquest.domain.attraction.repository.AttractionRepository">

  <select id="getSidoList" resultType="Sido">
    SELECT *
      FROM sidos
  </select>

  <select id="getGugunListBySido"
          parameterType="int"
          resultType="Gugun">
    SELECT *
      FROM guguns
     WHERE sido_code = #{sidoCode}
  </select>

  <select id="getContentTypeList" resultType="ContentType">
    SELECT *
      FROM contenttypes
  </select>

  <select id="searchAttractions"
          parameterType="AttractionSearchCondition"
          resultType="Attraction">
    SELECT *
      FROM attractions
     <where>
       <if test="sidoCode != null">
         AND area_code = #{sidoCode}
       </if>
       <if test="gugunCode != null">
         AND si_gun_gu_code = #{gugunCode}
       </if>
       <if test="contentTypeId != null">
         AND content_type_id = #{contentTypeId}
       </if>
       <if test="keyword != null and keyword.trim() != ''">
         AND title LIKE CONCAT('%', #{keyword}, '%')
       </if>
     </where>
  </select>

</mapper>
