<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.travelquest.domain.party.repository.PartyMemberRepository">

    <!-- ResultMap -->
    <resultMap id="partyMemberResultMap" type="com.ssafy.travelquest.domain.party.entity.PartyMember">
        <id property="id" column="id" />
        <result property="partyId" column="party_id" />
        <result property="userId" column="user_id" />
        <result property="jobCode" column="job_code" javaType="com.ssafy.travelquest.domain.user.entity.JobCode" />
        <result property="joinedAt" column="joined_at" />
    </resultMap>

    <!-- INSERT -->
    <insert id="insertPartyMember" parameterType="com.ssafy.travelquest.domain.party.entity.PartyMember"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO party_member (party_id, user_id, job_code, joined_at)
        VALUES (#{partyId}, #{userId}, #{jobCode}, #{joinedAt})
    </insert>

    <!-- DELETE by partyId and userId -->
    <delete id="deletePartyMember">
        DELETE FROM party_member
        WHERE party_id = #{partyId}
          AND user_id = #{userId}
    </delete>

    <!-- DELETE by userId -->
    <delete id="deletePartyMemberByUserId">
        DELETE FROM party_member
        WHERE user_id = #{userId}
    </delete>

    <!-- SELECT 전체 PartyMember 리스트 -->
    <select id="getPartyMembersByPartyId" resultMap="partyMemberResultMap">
        SELECT id, party_id, user_id, job_code, joined_at
        FROM party_member
        WHERE party_id = #{partyId}
    </select>

</mapper>
