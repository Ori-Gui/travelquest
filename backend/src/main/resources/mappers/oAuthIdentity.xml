<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//MyBatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.travelquest.domain.oauth.repository.OAuthRepository">

    <!-- create 메서드 -->
    <insert id="create" parameterType="com.ssafy.travelquest.domain.oauth.entity.OAuthIdentity">
        INSERT INTO oauth_identity (sub, provider, user_id)
        VALUES (#{sub}, #{provider}, #{userId})
    </insert>

    <resultMap id="OAuthIdentityMap" type="com.ssafy.travelquest.domain.oauth.entity.OAuthIdentity">
	    <id property="oauthIdentityId" column="oauth_identity_id" />
	    <result property="sub" column="sub" />
	    <result property="provider" column="provider" />
	    <result property="userId" column="user_id" />
	</resultMap>
	
	<select id="findWithUserBySubAndProvider"
	        resultMap="OAuthIdentityMap">
	    SELECT oauth_identity_id, sub, provider, user_id
	    FROM oauth_identity
	    WHERE sub = #{sub}
	    AND provider = #{provider}
	</select>


</mapper>
